<?xml version="1.0"?>
<scenario>

	<environment>
		<ned latitude="41.7777" longitude="3.0333"/>
		<ocean>
			<water density="1031.0" jerlov="0.15"/>
		</ocean>
		<atmosphere>
			<sun azimuth="20.0" elevation="50.0"/>
		</atmosphere>
	</environment>

	<robot name="bluerov2" fixed="false" self_collisions="false">

		<base_link name="base_link" type="compound" physics="submerged">

			<external_part name="Base" type="model" physics="submerged" buoyant="false">
				<visual>
					<mesh filename="bluerov2/joint/bluerov2.obj" scale="1.0"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</visual>
				<physical>
					<mesh filename="bluerov2/simple_hydro/bluerov2_base_phy.obj" scale="1.0"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</physical>
				<material name="Polycarbonate"/>
				<look name="bluerov2_joint"/>
				<mass value="7.9"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</external_part>

			<internal_part name="LeftFoam" type="cylinder" physics="submerged" buoyant="true">
				<dimensions radius="0.055" height="0.42"/>
				<origin rpy="0.0 1.57 0.0" xyz="0.0 0.11 -0.05"/>
				<material name="Foam"/>
				<look name="transparent"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</internal_part> 
			<internal_part name="RightFoam" type="cylinder" physics="submerged" buoyant="true">
				<dimensions radius="0.055" height="0.42"/>
				<origin rpy="0.0 1.57 0.0" xyz="0.0 -0.11 -0.05"/>
				<material name="Foam"/>
				<look name="transparent"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</internal_part> 

			<!-- <external_part name="LeftFoam" type="model" physics="submerged" buoyant="true">
				<visual>
					<mesh filename="bluerov2/simple_hydro/left_foam.obj" scale="1.0"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</visual>
				<physical>
					<mesh filename="bluerov2/simple_hydro/left_foam_phy.obj" scale="1.0"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</physical>
				<material name="Foam"/>
				<look name="blue"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</external_part>
			<external_part name="RightFoam" type="model" physics="submerged" buoyant="true">
				<visual>
					<mesh filename="bluerov2/simple_hydro/right_foam.obj" scale="1.0"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</visual>
				<physical>
					<mesh filename="bluerov2/simple_hydro/right_foam_phy.obj" scale="1.0"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</physical>
				<material name="Foam"/>
				<look name="blue"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</external_part>

			<external_part name="CameraDome" type="model" physics="submerged" buoyant="false">
				<visual>
					<mesh filename="bluerov2/dome.obj" scale="1.0"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</visual>
				<physical>
					<mesh filename="bluerov2/dome.obj" scale="1.0"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</physical>
				<material name="Acrylic"/>
				<look name="transparent"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</external_part> -->

			<!--   FIX HYDRODYNAMICS AND THRUSTERS   -->

			<!-- <internal_part name="BallastBottom" type="cylinder" physics="submerged" buoyant="false">
				<dimensions radius="0.11" height="0.03"/>
				<origin rpy="0.0 0.0 0.0" xyz="-0.335 0.0 0.0"/>
				<material name="Ballast"/>
				<look name="transparent"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</internal_part>  -->

		</base_link>

		<!--   THRUSTERS   -->

		<!-- T1 -->
		<actuator name="Thruster_R_FORWARD_FRONT" type="thruster">
			<origin rpy="0.0 0.0 -${46*pi/180}" xyz="0.13 0.098 0.028"/>
    		<specs max_setpoint="${3500.0/60.0*2.0*pi}" inverted_setpoint="true" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="false">
				<mesh filename="bluerov2/simple_hydro/ccw.obj" scale="1.02"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
		    <rotor_dynamics type="first_order">
				<time_constant value="0.2"/>
		    </rotor_dynamics>
		    <thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.07" reverse="0.11"/>
				<torque_coeff value="0.015"/>
		    </thrust_model>
			<link name="base_link"/>
		</actuator>

		<!-- T2 -->
		<actuator name="Thruster_L_FORWARD_FRONT" type="thruster">
			<origin rpy="0.0 0.0 ${46*pi/180}" xyz="0.13 -0.098 0.028"/>
    		<specs max_setpoint="${3500.0/60.0*2.0*pi}" inverted_setpoint="true" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="false">
				<mesh filename="bluerov2/simple_hydro/ccw.obj" scale="1.02"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
		    <rotor_dynamics type="first_order">
				<time_constant value="0.2"/>
		    </rotor_dynamics>
		    <thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.07" reverse="0.11"/>
				<torque_coeff value="0.015"/>
		    </thrust_model>
			<link name="base_link"/>
		</actuator>

		<!-- T3 -->
		<actuator name="Thruster_R_FORWARD_REAR" type="thruster">
			<origin rpy="0.0 0.0 ${48*pi/180 + pi}" xyz="-0.157 0.096 0.028"/>
    		<specs max_setpoint="${3500.0/60.0*2.0*pi}" inverted_setpoint="false" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="true">
				<mesh filename="bluerov2/simple_hydro/cw.obj" scale="1.02"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
		    <rotor_dynamics type="first_order">
				<time_constant value="0.2"/>
		    </rotor_dynamics>
		    <thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.07" reverse="0.11"/>
				<torque_coeff value="0.015"/>
		    </thrust_model>
			<link name="base_link"/>
		</actuator>

		<!-- T4 -->
		<actuator name="Thruster_L_FORWARD_REAR" type="thruster">
			<origin rpy="0.0 0.0 -${48*pi/180 + pi} " xyz="-0.157 -0.096 0.028"/>
    		<specs max_setpoint="${3500.0/60.0*2.0*pi}" inverted_setpoint="false" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="true">
				<mesh filename="bluerov2/simple_hydro/cw.obj" scale="1.02"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
		    <rotor_dynamics type="first_order">
				<time_constant value="0.2"/>
		    </rotor_dynamics>
		    <thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.07" reverse="0.11"/>
				<torque_coeff value="0.015"/>
		    </thrust_model>
			<link name="base_link"/>
		</actuator>

		<!-- T5 -->
		<actuator name="Thruster_R_UP_FRONT" type="thruster">
			<origin rpy="0.0 ${pi/2} 0.0" xyz="0.117 0.218 -0.04"/>
    		<specs max_setpoint="${3500.0/60.0*2.0*pi}" inverted_setpoint="true" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="true">
				<mesh filename="bluerov2/simple_hydro/cw.obj" scale="1.01"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
		    <rotor_dynamics type="first_order">
				<time_constant value="0.2"/>
		    </rotor_dynamics>
		    <thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.07" reverse="0.11"/>
				<torque_coeff value="0.015"/>
		    </thrust_model>
			<link name="base_link"/>
		</actuator>

		<!-- T6 -->
		<actuator name="Thruster_L_UP_FRONT" type="thruster">
			<origin rpy="0.0 ${pi/2} 0.0" xyz="0.117 -0.218 -0.04"/>
    		<specs max_setpoint="${3500.0/60.0*2.0*pi}" inverted_setpoint="true" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="false">
				<mesh filename="bluerov2/simple_hydro/ccw.obj" scale="1.01"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
		    <rotor_dynamics type="first_order">
				<time_constant value="0.2"/>
		    </rotor_dynamics>
		    <thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.07" reverse="0.11"/>
				<torque_coeff value="0.015"/>
		    </thrust_model>
			<link name="base_link"/>
		</actuator>

		<!-- T7 -->
		<actuator name="Thruster_R_UP_REAR" type="thruster">
			<origin rpy="0.0 ${pi/2} 0.0" xyz="-0.123 0.218 -0.04"/>
    		<specs max_setpoint="${3500.0/60.0*2.0*pi}" inverted_setpoint="true" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="false">
				<mesh filename="bluerov2/simple_hydro/ccw.obj" scale="1.01"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
		    <rotor_dynamics type="first_order">
				<time_constant value="0.2"/>
		    </rotor_dynamics>
		    <thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.07" reverse="0.11"/>
				<torque_coeff value="0.015"/>
		    </thrust_model>
			<link name="base_link"/>
		</actuator>

		<!-- T8 -->
		<actuator name="Thruster_L_UP_REAR" type="thruster">
			<origin rpy="0.0 ${pi/2} 0.0" xyz="-0.123 -0.218 -0.04"/>
    		<specs max_setpoint="${3500.0/60.0*2.0*pi}" inverted_setpoint="true" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="true">
				<mesh filename="bluerov2/simple_hydro/cw.obj" scale="1.01"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
		    <rotor_dynamics type="first_order">
				<time_constant value="0.2"/>
		    </rotor_dynamics>
		    <thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.07" reverse="0.11"/>
				<torque_coeff value="0.015"/>
		    </thrust_model>
			<link name="base_link"/>
		</actuator>

		<!--   LIGHTS   -->		
		<light name="Light_LD">
			<specs radius="0.01" cone_angle="40.0" illuminance="10000.0"/>
			<color temperature="5600.0"/>
			<origin xyz="0.1675 -0.19 0.072" rpy="0.0 ${pi/2 - pi*20/180} 0.0"/>
			<link name="base_link"/>
			<ros_service topic="/bluerov/lights/ld"/>
		</light>
		<light name="Light_LU">
			<specs radius="0.01" cone_angle="40.0" illuminance="10000.0"/>
			<color temperature="5600.0"/>
			<origin xyz="0.162 -0.188 -0.088" rpy="0.0 ${pi/2 - pi*10/180}  0.0"/>
			<link name="base_link"/>
			<ros_service topic="/bluerov/lights/lu"/>
		</light>
		<light name="Light_RD">
			<specs radius="0.01" cone_angle="40.0" illuminance="10000.0"/>
			<color temperature="5600.0"/>
			<origin xyz="0.1675 0.19 0.072" rpy="0.0 ${pi/2 - pi*20/180} 0.0"/>
			<link name="base_link"/>
			<ros_service topic="/bluerov/lights/rd"/>
		</light>
		<light name="Light_RU">
			<specs radius="0.01" cone_angle="40.0" illuminance="10000.0"/>
			<color temperature="5600.0"/>
			<origin xyz="0.162 0.188 -0.088" rpy="0.0 ${pi/2 - pi*10/180} 0.0"/>
			<link name="base_link"/>
			<ros_service topic="/bluerov/lights/ru"/>
		</light>


		<!--   SENSORS   -->
		<sensor name="Odometry" type="odometry" rate="10.0">
			<link name="base_link"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<!-- <ros_publisher topic="/$(arg robot_name)/dynamics/odometry"/> -->
			<ros_publisher topic="/bluerov/navigator/odometry"/>
		</sensor>

		<!-- <sensor name="dvl" type="dvl" rate="5.0">
			<link name="base_link"/>
